# CodeQuest Backend - Environment variables
# Copy to .env and fill in values

# Database (PostgreSQL). Use async driver URL for async SQLAlchemy.
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/codequest

# Sync URL for Alembic migrations (Alembic uses sync driver)
DATABASE_URL_SYNC=postgresql+psycopg://user:password@localhost:5432/codequest

# App
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1

# JWT (used from Milestone 5)
SECRET_KEY=your-secret-key-min-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# AI hint service (OpenAI-compatible)
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=your-openai-api-key
AI_MODEL=gpt-4o-mini

# Judge0 code execution
# Dev: Judge0 CE on RapidAPI
JUDGE0_BASE_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_HOST=judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=your-rapidapi-key
# Prod: self-hosted Judge0 (no key/host needed)
# JUDGE0_BASE_URL=https://judge0.your-domain.example
# JUDGE0_API_HOST=
# JUDGE0_API_KEY=
JUDGE0_TIMEOUT_SECONDS=10

# Local sandbox fallback (DEV ONLY). Never enable in production.
USE_LOCAL_SANDBOX=false

# Email verification
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_OTP_TTL_MINUTES=15
EMAIL_VERIFICATION_MAX_ATTEMPTS=3

# SMTP Config
SMTP_HOST=your-smtp-host
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASSWORD=your-smtp-password
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=codequest@dev.com
SMTP_TIMEOUT_SECONDS=10